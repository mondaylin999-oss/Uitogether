{
  "name": "uitogether-backend",
  "version": "1.0.0",
  "private": true,
  "description": "UITogether - student community REST API (Node.js + Express + PostgreSQL)",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:create": "node scripts/db/create-database.js",
    "db:migrate": "node scripts/db/migrate.js",
    "db:setup": "node scripts/db/setup.js",
    "db:seed": "node scripts/db/seed.js",
    "db:reset": "node scripts/db/reset.js",
    "db:status": "node scripts/db/status.js",
    "db:schema": "node scripts/db/build-schema.js"
  },
  "keywords": [
    "uitogether",
    "express",
    "postgres",
    "rest-api"
  ],
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
