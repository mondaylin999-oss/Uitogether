# ============================================================
#  UITogether backend - environment template
#  Copy to backend/.env and fill in the values.
#  .env is gitignored and must NEVER be committed.
# ============================================================

# --- server ---
NODE_ENV=development
# NOTE: macOS uses port 5000 for the AirPlay Receiver (ControlCenter).
# 5050 avoids that conflict. Disable it under System Settings > General >
# AirDrop & Handoff if you prefer 5000.
PORT=5050

# --- PostgreSQL (local development) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=uitogether_db
DB_CONNECTION_LIMIT=10

# PostgreSQL always connects to SOME database, so `npm run db:create` issues
# its CREATE DATABASE from this one. Every server ships with it; you only need
# to change this if your provider named it something else.
# DB_MAINTENANCE_NAME=postgres

# --- hosted PostgreSQL (production / Render) ---
# Managed providers hand out one URI instead of the five variables above.
# Render injects DATABASE_URL automatically from the database in render.yaml,
# so in production you normally set nothing here at all.
#
# Set it by hand only when running the db:* scripts from your own machine
# against the hosted database - use Render's EXTERNAL connection string, which
# unlike the internal one requires TLS:
# DATABASE_URL=postgresql://uitogether:password@dpg-xxxx.singapore-postgres.render.com/uitogether_db
# DB_SSL=true
#
# DB_SSL=true encrypts the connection. Managed providers sign with their own
# CA, so the certificate chain is not verified unless you also paste their CA
# bundle here as a single value.
# DB_SSL_CA=

# --- authentication ---
# Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=uitogether_token

# bcrypt cost factor. 12 is a good default; raise it for production.
BCRYPT_SALT_ROUNDS=12

# --- CORS ---
# Origins allowed to call this API. Comma separated. A bare hostname is
# accepted and normalised to https://, so Render's service-host substitution
# works as-is.
CLIENT_URL=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://localhost:3000

# --- rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
