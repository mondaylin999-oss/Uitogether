# ============================================================
#  UITogether backend - environment template
#  Copy to backend/.env and fill in DB_PASSWORD.
#  .env is gitignored and must NEVER be committed.
# ============================================================

# --- server ---
NODE_ENV=development
# NOTE: macOS uses port 5000 for the AirPlay Receiver (ControlCenter).
# 5050 avoids that conflict. Disable it under System Settings > General >
# AirDrop & Handoff if you prefer 5000.
PORT=5050

# --- MySQL ---
# This project targets MAMP's MySQL, which listens on TCP port 8889.
DB_HOST=127.0.0.1
DB_PORT=8889
# Standard (non-MAMP) MySQL installs use 3306 instead:
# DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=uitogether_db
DB_CONNECTION_LIMIT=10

# Optional. Some MySQL installs listen on a UNIX socket only, with no TCP
# port. When set, DB_HOST/DB_PORT are ignored. Leave it commented out for
# MAMP over TCP.
#   MAMP                   : /Applications/MAMP/tmp/mysql/mysql.sock
#   macOS /usr/local/mysql : /tmp/mysql.sock
# DB_SOCKET=/Applications/MAMP/tmp/mysql/mysql.sock

# --- authentication ---
# Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=uitogether_token

# bcrypt cost factor. 12 is a good default; raise it for production.
BCRYPT_SALT_ROUNDS=12

# --- CORS ---
# Origins allowed to call this API. Comma separated, no trailing slash.
# The frontend will be built separately and served from one of these.
CLIENT_URL=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://localhost:3000

# --- rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
